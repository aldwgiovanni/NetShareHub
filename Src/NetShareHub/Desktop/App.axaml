<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetShareHub.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground" Color="#F2F4F9" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#E1E5EE" />
          <SolidColorBrush x:Key="RowBackground" Color="#F6F7FB" />
          <SolidColorBrush x:Key="MutedText" Color="#667085" />
          <SolidColorBrush x:Key="OkBrush" Color="#16A34A" />
          <SolidColorBrush x:Key="WarnBrush" Color="#D97706" />
          <SolidColorBrush x:Key="BadBrush" Color="#DC2626" />
          <SolidColorBrush x:Key="OkSoft" Color="#E8F7EE" />
          <SolidColorBrush x:Key="WarnSoft" Color="#FFF4E0" />
          <SolidColorBrush x:Key="BadSoft" Color="#FDECEC" />
          <SolidColorBrush x:Key="AccentSoft" Color="#EAF0FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground" Color="#14161C" />
          <SolidColorBrush x:Key="CardBackground" Color="#1D2029" />
          <SolidColorBrush x:Key="CardBorder" Color="#2C303C" />
          <SolidColorBrush x:Key="RowBackground" Color="#252935" />
          <SolidColorBrush x:Key="MutedText" Color="#9AA3B5" />
          <SolidColorBrush x:Key="OkBrush" Color="#4ADE80" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
          <SolidColorBrush x:Key="BadBrush" Color="#F87171" />
          <SolidColorBrush x:Key="OkSoft" Color="#173323" />
          <SolidColorBrush x:Key="WarnSoft" Color="#3A2E12" />
          <SolidColorBrush x:Key="BadSoft" Color="#3B1A1C" />
          <SolidColorBrush x:Key="AccentSoft" Color="#1F2A47" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource RowBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Fill" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Ellipse.dot.ok">
      <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.bad">
      <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
    </Style>

    <Style Selector="Border.status">
      <Setter Property="Background" Value="{DynamicResource RowBackground}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    </Style>
    <Style Selector="Border.status.running">
      <Setter Property="Background" Value="{DynamicResource OkSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="Border.status.faulted">
      <Setter Property="Background" Value="{DynamicResource BadSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource BadBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
  </Application.Styles>
</Application>
