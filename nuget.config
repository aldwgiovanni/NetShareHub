<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Ce dépôt n'utilise que nuget.org : les flux privés de la configuration globale ne sont pas interrogés. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
